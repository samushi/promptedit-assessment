APP_NAME=PromptEdit
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=promptedit
DB_USERNAME=promptedit
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Pixelforge: use a separate API key + webhook signing secret per environment
# (local vs deployed). Never commit real values.
PIXELFORGE_BASE_URL=https://pixelforge.promptedit.dev/v1
PIXELFORGE_API_KEY=
PIXELFORGE_WEBHOOK_SECRET=

# Recurring pixelforge:reconcile sweep. Unset: every minute locally, off in
# production (see LARAVEL_CLOUD_DEPLOYMENT.md). A cron expression sets it,
# "false" turns it off.
# PIXELFORGE_RECONCILE_SCHEDULE="* * * * *"

# Abuse guards for the public demo: generations per UTC day (0 = no limit).
# PIXELFORGE_USER_DAILY_LIMIT=30
# PIXELFORGE_DAILY_LIMIT=200

# Docker (compose.yaml): host ports and the user the containers run as
# (on macOS use `id -u` / `id -g`, e.g. 501 / 20).
APP_PORT=8000
FORWARD_DB_PORT=54329
FORWARD_REDIS_PORT=63790
VITE_PORT=5174
WWWUSER=1000
WWWGROUP=1000
