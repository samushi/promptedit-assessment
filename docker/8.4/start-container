#!/usr/bin/env bash

if [ "$SUPERVISOR_PHP_USER" != "root" ] && [ "$SUPERVISOR_PHP_USER" != "sail" ]; then
    echo "You should set SUPERVISOR_PHP_USER to either 'sail' or 'root'."
    exit 1
fi

if [ ! -z "$WWWUSER" ]; then
    usermod -u $WWWUSER sail
fi

if [ ! -d /.composer ]; then
    mkdir /.composer
fi

# PromptEdit: in laravel.test, node_modules is its own Docker volume (Linux
# binaries, separate from the host's). A new volume is owned by root, so hand it
# to sail once. Containers that only see the host folder through the bind mount
# (horizon, scheduler) must not touch it.
if mountpoint -q /var/www/html/node_modules && [ "$(stat -c %U /var/www/html/node_modules)" != "sail" ]; then
    chown -R sail /var/www/html/node_modules
fi

chmod -R ugo+rw /.composer

if [ $# -gt 0 ]; then
    if [ "$SUPERVISOR_PHP_USER" = "root" ]; then
        exec "$@"
    else
        exec gosu $WWWUSER "$@"
    fi
else
    exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf
fi
